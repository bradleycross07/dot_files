# files that live in the repo but should never be applied to $HOME
README.md
INSTALL.md

# generated by update-desktop-database, rebuilt automatically
.local/share/applications/mimeinfo.cache

# ------------------------------------------------------------------
# laptop-only (hostname "void") - skipped on every other machine
# ------------------------------------------------------------------
{{- if ne .chezmoi.hostname "void" }}

# monitor profiles use the laptop panel (eDP-1)
.config/kanshi
.config/kanshi/**

# lid close handling
.local/bin/lid-handler.sh

# session extras the desktop's autostart.sh doesn't run
.local/bin/clipboard-picker.sh
.config/gammastep
.config/gammastep/**
.config/xsettingsd
.config/xsettingsd/**

# laptop-only apps: VS Code, ProjectLibre, Vivado (and Vivado's launcher entries)
.local/bin/update-vscode
.local/bin/code
.local/bin/vivado
.local/share/applications/code.desktop
.local/share/applications/projectlibre.desktop
.local/share/icons/hicolor/128x128/apps/projectlibre.png
.local/share/applications/*2023.2*.desktop
.local/share/applications/Documentation Navigator_*.desktop
.local/share/applications/Uninstall *.desktop
.local/share/applications/Xilinx Information Center_*.desktop

# laptop-only system configs:
#   TLP (battery/power), zram + its zram-tuned sysctl, iwd (wifi), GRUB
#   (the desktop uses ethernet only, no swap, Limine, no local resolver)
.config/system-configs/tlp.conf
.config/system-configs/zramen.conf
.config/system-configs/99-vm.conf
.config/system-configs/iwd-main.conf
.config/system-configs/grub
# local DNS resolver (desktop uses Cloudflare directly via dhcpcd.conf template)
.config/system-configs/unbound.conf

{{- end }}

