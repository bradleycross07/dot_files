#!/bin/sh

# let D-Bus activated services (portals etc.) find the Wayland session
dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
{{ if eq .chezmoi.hostname "void" }}
# gnome keyring
gnome-keyring-daemon --start --components=secrets &

# polkit authentication agent
/usr/libexec/polkit-gnome-authentication-agent-1 &

# audio (pipewire starts wireplumber and pipewire-pulse via ~/.config/pipewire/pipewire.conf.d)
pipewire &

# audio processing
( while ! wpctl status >/dev/null 2>&1; do sleep 0.2; done
  sway-audio-idle-inhibit &
  easyeffects --gapplication-service ) &

# monitors
kanshi &

# x11 stuff
xsettingsd &

# night light
gammastep &

# clipboard history
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

# idling
swayidle -w \
  timeout 600   'waylock -fork-on-lock' \
  timeout 900   'wlopm --off "*"' \
  resume        'wlopm --on "*"' \
  timeout 10800 'doas poweroff' \
  before-sleep  'waylock -fork-on-lock' &
{{- else }}
# audio (pipewire starts wireplumber and pipewire-pulse via ~/.config/pipewire/pipewire.conf.d)
pipewire &

# idling: lock after 10 min, screen off after 15 (protects the OLED)
# games, mpv and Firefox video inhibit idle on their own
swayidle -w \
  timeout 600   'waylock -fork-on-lock' \
  timeout 900   'wlopm --off "*"' \
  resume        'wlopm --on "*"' \
  before-sleep  'waylock -fork-on-lock' &
{{- end }}
