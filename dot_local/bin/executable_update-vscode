#!/bin/sh
set -eu

dest="$HOME/.local/opt/VSCode-linux-x64"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if [ -x "$dest/bin/code" ]; then
    commit=$("$dest/bin/code" --version | sed -n 2p)
    status=$(curl -sS -o "$tmp/update.json" -w '%{http_code}' \
        "https://update.code.visualstudio.com/api/update/linux-x64/stable/$commit") \
        || { echo "Couldn't reach the VS Code update server" >&2; exit 1; }

    case $status in
        204) echo "VS Code already up to date"; exit 0 ;;
        200) echo "Installing VS Code $(jq -r .productVersion "$tmp/update.json")" ;;
        *)   echo "Unexpected response from the update server (HTTP $status)" >&2; exit 1 ;;
    esac
fi

curl -fL -o "$tmp/vscode.tar.gz" 'https://code.visualstudio.com/sha/download?build=stable&os=linux-x64'
tar -xzf "$tmp/vscode.tar.gz" -C "$tmp"

rm -rf "$dest.old"
[ -d "$dest" ] && mv "$dest" "$dest.old"
mv "$tmp/VSCode-linux-x64" "$dest"
echo "Done. Old version kept at $dest.old"
