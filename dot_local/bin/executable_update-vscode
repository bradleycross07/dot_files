#!/bin/sh
set -e
dest="$HOME/.local/opt/VSCode-linux-x64"

if [ -x "$dest/bin/code" ]; then
    commit=$("$dest/bin/code" --version | sed -n 2p)
    status=$(curl -s -o /dev/null -w '%{http_code}' \
        "https://update.code.visualstudio.com/api/update/linux-x64/stable/$commit")
    if [ "$status" = 204 ]; then
        echo "VS Code already up to date"
        exit 0
    fi
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fL -o "$tmp/vscode.tar.gz" 'https://code.visualstudio.com/sha/download?build=stable&os=linux-x64'
tar -xzf "$tmp/vscode.tar.gz" -C "$tmp"
rm -rf "$dest.old"
[ -d "$dest" ] && mv "$dest" "$dest.old"
mv "$tmp/VSCode-linux-x64" "$dest"
echo "VS Code updated (old copy at $dest.old)"
