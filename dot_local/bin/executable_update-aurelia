#!/bin/sh
set -eu

cd ~/.local/src/Aurelia
stamp=.git/installed-commit
git switch -q local
git fetch -q --prune

if ! git rebase -q origin/main; then
    git rebase --abort 2>/dev/null || true
    echo "Rebase onto origin/main failed; 'local' left as it was" >&2
    exit 1
fi

if [ "$(cat "$stamp" 2>/dev/null)" = "$(git rev-parse HEAD)" ]; then
    echo "Aurelia already up to date"
    exit 0
fi

cargo build --release
cp target/release/aurelia ~/.local/bin/aurelia.new
mv ~/.local/bin/aurelia.new ~/.local/bin/aurelia
git rev-parse HEAD > "$stamp"
cargo clean
echo "Installed $(~/.local/bin/aurelia --version)"
