#!/bin/sh
# venmic-fix

mic=$(wpctl inspect @DEFAULT_AUDIO_SOURCE@ | sed -n 's/.*node.name = "\(.*\)"/\1/p')

found=no
for cap in $(pw-link -i | grep -o 'venmic-loopback-capture-[0-9]*-[0-9]*' | sort -u); do
    found=yes

    # the app venmic wanted: the first number in the loopback's name is its node id
    id=${cap#venmic-loopback-capture-}
    id=${id%%-*}
    src=$(pw-cli info "$id" 2>/dev/null | sed -n 's/.*node.name = "\(.*\)"/\1/p')

    if [ -z "$src" ]; then
        echo "$cap: node $id not found, skipping" >&2
        continue
    fi

    for ch in FL FR; do
        pw-link -d "$mic:capture_$ch" "$cap:input_$ch" 2>/dev/null   # drop the mic
        pw-link "$src:output_$ch" "$cap:input_$ch" 2>/dev/null        # feed it the app
    done
    echo "$cap: now capturing $src"
done

[ "$found" = yes ] || echo "no venmic loopbacks - start a stream first" >&2
