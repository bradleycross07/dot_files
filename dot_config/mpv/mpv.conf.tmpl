# youtube wrapper delay
script-opts-append=ytdl_hook-ytdl_path=/home/bradley/.local/bin/yt-dlp-mpv

{{ if eq .chezmoi.hostname "void-desktop" -}}
# hardware decoding - RX 9070 (decodes AV1 too)
hwdec=vaapi
hwdec-codecs=h264,hevc,vp9,av1,mpeg2video,vc1

# youtube: any codec the GPU decodes, up to the monitor's 1440p
ytdl-format=bestvideo[height<=1440][dynamic_range=SDR]+bestaudio/bestvideo[height<=1440]+bestaudio/best
{{ else -}}
# hardware decoding - AMD 5500U iGPU
hwdec=vaapi
hwdec-codecs=h264,hevc,vp9,mpeg2video,vc1

# youtube with VP9 decoder
ytdl-format=bestvideo[vcodec~='^vp0?9'][height<=1440][dynamic_range=SDR]+bestaudio/bestvideo[vcodec~='^vp0?9'][height<=1440]+bestaudio/best
{{ end -}}
save-position-on-quit=yes

# native wayland output
vo=gpu-next
gpu-api={{ if eq .chezmoi.hostname "void-desktop" }}vulkan{{ else }}opengl{{ end }}
gpu-context=wayland

# fill the whole window and letterbox inside it, instead of shrinking
# the window to the video's aspect ratio (avoids gaps in dwl)
keepaspect-window=no

# audio
ao=pipewire

# reduce banding/blocking in dark gradients
# deband=yes

# scaling
scale=ewa_lanczossharp
{{- if eq .chezmoi.hostname "void-desktop" }}
cscale=lanczos
dscale=mitchell
{{- else }}
cscale=hermite
{{- end }}

# HDR tone mapping
tone-mapping=auto
hdr-compute-peak=no
target-colorspace-hint=auto

# cache for smoother local file playback
cache=yes
cache-pause=no
demuxer-max-bytes=400MiB
demuxer-max-back-bytes=100MiB
demuxer-readahead-secs=30

# subtitles
sub-auto=fuzzy
sub-font-size=34
sub-border-size=2.5

# screenshot format
screenshot-format=png
screenshot-high-bit-depth=yes
screenshot-directory=~/Pictures/Screenshots
screenshot-template="%F-%wH.%wM.%wS"

# misc
msg-level=ffmpeg=no

[yt4k]
ytdl-format={{ if eq .chezmoi.hostname "void-desktop" }}bestvideo[height<=2160][dynamic_range=SDR]+bestaudio/best{{ else }}bestvideo[vcodec~='^vp0?9'][height<=2160][dynamic_range=SDR]+bestaudio/best{{ end }}
cscale=lanczos
dscale=hermite
deband=yes
