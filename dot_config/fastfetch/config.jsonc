{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt" // pompompurin ASCII art
  },
  "display": {
    "color": {
      "title": "#F6F2AF"
    },
    "percent": {
      "color": {
        "green": "#B8D4A0"
      }
    },
    "separator": " -> "
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "keyColor": "#B8916B" },
    { "type": "host", "keyColor": "#B8916B" },
    { "type": "kernel", "keyColor": "#BD9769" },
    { "type": "uptime", "keyColor": "#C29D67" },
    { "type": "display", "keyColor": "#C6A365" },
    { "type": "de", "keyColor": "#CBA863" },
    { "type": "wm", "keyColor": "#D0AE61" },
    { "type": "wmtheme", "keyColor": "#D5B45E" },
    { "type": "theme", "keyColor": "#DABA5C" },
    { "type": "font", "keyColor": "#DFC05A" },
    { "type": "terminal", "keyColor": "#E4C558" },
    { "type": "terminalfont", "keyColor": "#E9CB56" },
    { "type": "cpu", "keyColor": "#EED154" },
    { "type": "gpu", "keyColor": "#F0C242" },
    { "type": "memory", "keyColor": "#F0C242" },
    { "type": "swap", "keyColor": "#F0C242" },
    { "type": "disk", "keyColor": "#F0C242" },
    { "type": "poweradapter", "keyColor": "#F0C242" },
    { "type": "locale", "keyColor": "#F0C242" },
    "break",
    "colors"
  ]
}
