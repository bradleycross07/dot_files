# external monitor plugged in
profile docked {
	output HDMI-A-1 enable mode 2560x1440@144Hz position 0,0
	output eDP-1 enable mode 1920x1080@60Hz position 2560,0
}

# only internal monitor
profile laptop_only {
	output eDP-1 enable mode 1920x1080@60Hz position 0,0
}

# only external monitor
profile external_only {
	output HDMI-A-1 enable mode 2560x1440@144Hz position 0,0
}
