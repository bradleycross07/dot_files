// -*- mode: jsonc -*-
{
    // "layer": "top", // waybar at top layer
    // "position": "bottom", // waybar position (top|bottom|left|right)
    "height": 30, // waybar height
    "margin-top": 0,
    "spacing": 4, // gaps between modules
    "on-sigusr1": "toggle",
    "modules-left": [
        "dwl/tags"
    ],
    "modules-center": [
        "dwl/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "battery",
        "clock",
        "tray"
    ],
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "dwl/tags": {
	"num-tags": 9,
	"hide-vacant": true
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "timezone": "Europe/London",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%d-%m-%Y}"
    },
    "cpu": {
        "format": "{usage}%",
        "tooltip": false,
	"on-click": "kitty --class btop-float -e btop"
    },
    "memory": {
        "format": "{}%",
	"on-click": "kitty --class btop-float -e btop"
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C",
	"on-click": "kitty --class btop-float -e btop"
    },
    "battery": {
	"interval": 240,
        "states": {
            "good": 80,
            "warning": 20,
            "critical": 10
        },
        "format": "{capacity}%"
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
