### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu fuzzel
# Start waybar service
exec systemctl --user start waybar.service
# Toggle waybar
bindsym $mod+ctrl+shift+b exec killall -SIGUSR1 waybar
# Start easyffects service
exec sh -c 'pgrep -x easyeffects || easyeffects --gapplication-service'

#
### Idle Rules for Playback
#
# Firefox
for_window [app_id="firefox"] inhibit_idle fullscreen
# mpv
for_window [app_id="mpv"] inhibit_idle fullscreen
# night light
exec_always "pkill gammastep;gammastep >/dev/null 2>&1"
# audio limit
exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 80%

#
### floating
#
# GTK/Qt-Based Dialogs
for_window [window_type="dialog"] floating enable
# obisidan settings
for_window [app_id="md.Obsidian" title="^Settings"] floating enable
# Firefox Library (History, Downloads, Bookmarks etc.)
for_window [app_id="firefox" title="^Library$"] floating enable
# all xdg-dialogs
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
# volume control
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
# mpv
for_window [app_id="mpv"] floating enable
# imv
for_window [app_id="imv"] floating enable
# Firefox popup dialogs
for_window [app_id="firefox" title="(?i)(sign in|log in|oauth|authorize)"] floating enable
# HK: Silksong
for_window [class="steam_app_1030300"] floating enable
# HK
for_window [title="Hollow Knight"] floating enable
# Wallpaper Engine
for_window [class="steam_app_431960"] floating enable
# Steam settings
for_window [class="steam" title="Steam Settings"] floating enable
# qBitTorrent
for_window [app_id="org.qbittorrent.qBittorrent"] floating enable
# SumatraPDF
for_window [class="sumatrapdf.exe"] floating enable, move position center

#
### Output configuration
#
# more backgrounds are available in /usr/share/backgrounds/sway/
exec_always "pkill swaybg;swaybg -c '#000000' >/dev/null 2>&1"

# window border colors
# class            border     background    text        indicator     child_border
client.focused     #F6F2AF    #F6F2AF       #000000     #F6F2AF       #F6F2AF 
client.unfocused   #684E3A    #684E3A       #F5E6CA     #684E3A       #684E3A

# xwayland apps allow tearing
for_window [shell="xwayland"] allow_tearing yes

# keyring daemon
exec /usr/bin/gnome-keyring-daemon --start --components=secrets 

# pixel border
default_border pixel 2
default_floating_border pixel 2

# mouse focus disabled
focus_follows_mouse no

# gaps
gaps inner 3
gaps outer 3

# smart gaps
smart_gaps on

# hide edge borders
hide_edge_borders smart

# cursor theme
seat seat0 xcursor_theme "Bibata-Modern-Classic" 24

# laptop Monitor
output eDP-1 {
    modeline 133.32 1920 1928 1960 2000 1080 1097 1105 1111 +hsync -vsync
    scale 1
    position 2560,0
    adaptive_sync off
    max_render_time off
    render_bit_depth 8
    scale_filter nearest
    hdr off
}

# OLED second monitor
output HDMI-A-1 {
    modeline 586.586 2560 2568 2600 2640 1440 1529 1537 1543 +hsync -vsync
    # 1440p @ 144hz (CVT-RBv2)
    #modeline 583.20 1920 1928 1960 2000 1080 1201 1209 1215 +hsync -vsync
    # 1080p @ 240hz (CVT-RBv2)
    #modeline 422.524 1280 1288 1320 1360 720 849 857 863 +hsync -vsync
    # 720p @ 360hz (CVT-RBv2)
    scale 1
    position 0,0
    adaptive_sync off
    max_render_time off
    render_bit_depth 8
    scale_filter nearest
    hdr off
}

#
### Idle configuration
#
exec swayidle -w \
    timeout 600 'swaylock -f -c 000000' \
    timeout 1800 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 10800 'systemctl poweroff' \
    before-sleep 'swaylock -f -c 000000'

# any steam game
for_window [class="^steam_app_"] inhibit_idle visible

# hk & silksong
for_window [title="(?i)(hollow knight|silksong)"] inhibit_idle open

# screen lock on lid close
bindswitch --reload lid:on exec swaylock -f -c 000000

# screen lock
bindsym $mod+Escape exec swaylock -f -c 000000

#
### Input configuration
#

input type:touchpad {
   dwt enabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
   scroll_factor 0.5
}

input type:keyboard {
   xkb_layout "gb"
   repeat_delay 225
   repeat_rate 65
}

input "1008:911:HP,_Inc_HyperX_Alloy_Origins_65" {
  xkb_layout "us"
}

input "1356:3302:Sony_Interactive_Entertainment_DualSense_Wireless_Controller_Touchpad" {
    events disabled
}

#
### key bindings
#

# start foot
bindsym $mod+Return exec $term

# kill focused window
bindsym $mod+Shift+q kill

# start launcher
bindsym $mod+d exec $menu

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right mouse button for dragging.
floating_modifier $mod normal

# Reload the configuration file    
bindsym $mod+Shift+c reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# screenshotting
bindsym Print exec grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
bindsym $mod+Print exec sh -c 'g=$(slurp) && grim -g "$g" ~/Pictures/Screenshots/$(date +'\''%Y-%m-%d_%H-%M-%S'\'').png'
bindsym $mod+Shift+S exec sh -c 'g=$(slurp) && grim -g "$g" - | wl-copy --type image/png'

# file Managers
bindsym $mod+e exec thunar
bindsym $mod+f exec foot -e yazi

# firefox
bindsym $mod+b exec firefox

# start discord
bindsym $mod+Shift+p exec gtk-launch discord

#
### Moving around:
#
# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

#
### Workspaces:
#

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5


# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

#
### Layout stuff:
#

# Make the current focus fullscreen
bindsym $mod+shift+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# Move focus to the parent container
bindsym $mod+a focus parent

#
### Scratchpad:
#
# Sway has a "scratchpad", which is a bag of holding for windows.
# You can send windows there and get them back later.

# Move the currently focused window to the scratchpad
# bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
# bindsym $mod+minus scratchpad show

#
### Resizing containers:
#
mode "resize" {
	# left will shrink the containers width
	# right will grow the containers width
	# up will shrink the containers height
	# down will grow the containers height
	bindsym $left resize shrink width 10px
	bindsym $down resize grow height 10px
	bindsym $up resize shrink height 10px
	bindsym $right resize grow width 10px

	# Ditto, with arrow keys
	bindsym Left resize shrink width 10px
	bindsym Down resize grow height 10px
	bindsym Up resize shrink height 10px
	bindsym Right resize grow width 10px

	# Return to default mode
	bindsym Return mode "default"
	bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

#
### Utilities:
#
# special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# special keys to control media via playerctl
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

### notifications if needed
# exec_always "pkill swaync;swaync"

### GUI Prompts
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

include /etc/sway/config.d/*
