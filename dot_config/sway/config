### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu wofi --show drun -I --normal-window

### Idle Rules for Playback
#
# Idle Firefox
for_window [app_id="firefox"] inhibit_idle fullscreen
# Idle mpv
for_window [app_id="mpv"] inhibit_idle fullscreen
# Audio limit
exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 80%

### Floating
#
# Foot
for_window [app_id="foot" title="btop"] floating enable
# GTK/Qt-Based Dialogs
for_window [window_type="dialog"] floating enable
# Specifically for Obsidian
for_window [app_id="md.Obsidian" title="^Settings"] floating enable
# Firefox Library (History, Downloads, Bookmarks etc.)
for_window [app_id="firefox" title="^Library$"] floating enable
# Floating Windows for all xdg-dialogs
for_window [app_id="xdg-desktop-portal-gtk"] floating enable
# Thunar
for_window [app_id="thunar"] floating enable
# Volume Control
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
# mpv Video Player
for_window [app_id="mpv"] floating enable
# Floating windows use normal border
for_window [floating] border normal


### Output configuration
#
# More backgrounds are available in /usr/share/backgrounds/sway/
exec_always swaybg -c '#000000'

# Keyring Daemon
exec /usr/bin/gnome-keyring-daemon --start --components=secrets 

# Pixel border
default_border pixel 2

# Mouse focus disabled
focus_follows_mouse no

# Gaps
gaps inner 12
gaps outer 4

# Smart gaps
smart_gaps on

# Hide edge borders
hide_edge_borders smart

# Cursor theme
seat seat0 xcursor_theme "Bibata-Modern-Classic" 24

# Laptop Monitor
output eDP-1 {
    resolution 1920x1080@60Hz
    scale 1.5
    position 2560,720
}

# Second Monitor
output HDMI-A-1 {
    resolution 2560x1440@120Hz
    adaptive_sync off
    position 0,0
}

### Idle configuration

exec swayidle -w \
    timeout 600 'swaylock -f -c 000000' \
    timeout 1800 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000' 
    
# Screen lock on lid close
bindswitch --reload lid:on exec swaylock -f -c 000000

# Screen lock
bindsym $mod+Escape exec swaylock -f -c 000000

### Input configuration

input type:touchpad {
   xkb_options caps:escape
   dwt enabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
   dwt = disable-while-typing
}

input type:keyboard {
   xkb_layout "gb"
   xkb_options caps:escape
   repeat_delay 250
   repeat_rate 50
}

input "1008:911:HP,_Inc_HyperX_Alloy_Origins_65" {
  xkb_layout "us"
}

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
   
    # Screenshotting
    bindsym Print exec grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
    bindsym $mod+Print exec grim -g"$(slurp)" ~/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png
    bindsym $mod+Shift+S exec grim -g"$(slurp)" - | wl-copy --type image/png

   # File Managers
   bindsym $mod+e exec thunar
   bindsym $mod+f exec foot -e yazi

   # Firefox
   bindsym $mod+b exec firefox
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
