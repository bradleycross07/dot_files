# ~/.zshrc configuration

# starship theming
eval "$(starship init zsh)"

# zoxide
eval "$(zoxide init zsh)"

# zinit: plugin manager
source /nix/store/*-zinit-3.14.0/share/zinit/zinit.zsh(N)

# turbo-load completions
source <(fzf --zsh)
source <(gh completion -s zsh)
source <(kitty + complete setup zsh)

# history settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE   # prefix a command with a space to exclude it from history
setopt AUTO_CD             # type a directory name to cd into it

# spicetify
export PATH=$PATH:/home/bradley/.spicetify

bindkey '^R' history-incremental-search-backward

# open ff automatically
fastfetch
alias clear="command clear && printf '\e[3J' && fastfetch" # clear everything
