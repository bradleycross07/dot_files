# ~/.zshrc configuration

# zinit: plugin manager
source ~/.local/share/zinit/zinit.git/zinit.zsh

# starship theming
eval "$(starship init zsh)"

# completion
autoload -Uz compinit
compinit

# autocomplete suggestions
zinit light zsh-users/zsh-autosuggestions

# shell integrations & completions
source <(fzf --zsh)
source <(gh completion -s zsh)

# history settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE   # prefix a command with a space to exclude it from history
setopt AUTO_CD             # type a directory name to cd into it

# needed shell aliases
alias ff="fastfetch"
alias ls="eza --color=auto"
alias lt="eza --tree --color=auto"
alias cat="bat"
alias nano="nvim"
alias grep="rg"
alias du="dust"
alias df="duf"
alias ps="procs"

# VPN aliases (windscribe isn't on void manually installed it with config)
alias vpnup='doas wg-quick up windscribe'
alias vpndown='doas wg-quick down windscribe'

# start dwl with its own D-Bus session, logging to ~/.local/share/dwl.log
dwl() {
  if [ -n "$WAYLAND_DISPLAY" ]; then
    echo "dwl is already running" >&2
    return 1
  fi
  dbus-run-session dwl > "$HOME/.local/share/dwl.log" 2>&1

  # stop audio left running after quitting out of dwl
  pkill -u "$USER" -x 'pipewire|wireplumber'
}

# open ff automatically
fastfetch
alias clear="command clear && printf '\e[3J' && fastfetch" # clear everything

# zoxide
eval "$(zoxide init zsh)"

# syntax highlighting 
zinit light zsh-users/zsh-syntax-highlighting
