# ~/.zshrc configuration

# zinit: plugin manager
source ~/.local/share/zinit/zinit.git/zinit.zsh

# starship theming
eval "$(starship init zsh)"

# zoxide
eval "$(zoxide init zsh)"

# completion
autoload -Uz compinit
compinit

# autocomplete suggestions & syntax
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting

# turbo-load completions
source <(fzf --zsh)
source <(gh completion -s zsh)

# history settings
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE   # prefix a command with a space to exclude it from history
setopt AUTO_CD             # type a directory name to cd into it

bindkey '^R' history-incremental-search-backward

# needed shell aliases
alias ff="fastfetch"
alias ls="eza --color=always"
alias lt="eza --tree --color=always"
alias cat="bat"
alias nano="nvim"
alias grep="rg"
alias du="dust"
alias df="duf"
alias ps="procs"

# open ff automatically
fastfetch
alias clear="command clear && printf '\e[3J' && fastfetch" # clear everything

