diff --git a/src/commands/info.rs b/src/commands/info.rs
index ad5e2d2..22fe674 100644
--- a/src/commands/info.rs
+++ b/src/commands/info.rs
@@ -762,6 +762,9 @@ pub(crate) async fn cmd_achievements(app_id: u32, lang: Option<String>, json: bo
 
 pub(crate) async fn cmd_depots(app_id: u32, json: bool) -> Result<()> {
     let client = authed_client().await?;
+
+    eprintln!("DEBUG: ABOUT TO CALL get_depot_list({app_id})");
+
     let depots = client
         .get_depot_list(app_id)
         .await
diff --git a/src/steam_client.rs b/src/steam_client.rs
index 9e53351..e38e5d7 100644
--- a/src/steam_client.rs
+++ b/src/steam_client.rs
@@ -2112,12 +2112,34 @@ pub(crate) async fn pics_app_buffer(
     let response: CMsgClientPICSProductInfoResponse =
         connection.job(request).await.context(job_context)?;
 
+    eprintln!(
+        "DEBUG PICS response for app {appid}: {} apps returned",
+        response.apps.len()
+    );
+    
+    for entry in &response.apps {
+        eprintln!(
+            "DEBUG PICS entry: appid={}, buffer_len={}",
+            entry.appid(),
+            entry.buffer().len()
+        );
+    }
+    
     let app = response
         .apps
         .iter()
         .find(|entry| entry.appid() == appid)
         .ok_or_else(|| anyhow!("missing appinfo payload for app {appid}"))?;
-    Ok(app.buffer().to_vec())
+
+    let buffer = app.buffer();
+
+    eprintln!(
+        "PICS appinfo {appid}: buffer_len={}, buffer_prefix={:02x?}",
+        buffer.len(),
+        &buffer[..buffer.len().min(32)]
+    );
+
+    Ok(buffer.to_vec())
 }
 
 impl SteamClient {
diff --git a/src/steam_client/content.rs b/src/steam_client/content.rs
index 4ccb75d..5a4f4e6 100644
--- a/src/steam_client/content.rs
+++ b/src/steam_client/content.rs
@@ -98,9 +98,29 @@ impl SteamClient {
     }
 
     pub async fn get_depot_list(&self, app_id: u32) -> Result<Vec<DepotInfo>> {
-        let buffer = self
+        eprintln!("DEBUG: ENTERED get_depot_list({app_id})");
+
+        let buffer = match self
             .pics_buffer(app_id, "failed requesting appinfo product info for depot list")
-            .await?;
+            .await
+        {
+            Ok(buffer) => buffer,
+            Err(e) => {
+                eprintln!("DEBUG get_depot_list PICS ERROR for {app_id}: {e:#}");
+                return Err(e);
+            }
+        };            
+
+        eprintln!(
+            "DEBUG get_depot_list: app_id={app_id}, buffer_len={}, buffer_prefix={:02x?}",
+            buffer.len(),
+            &buffer[..buffer.len().min(32)]
+        );
+
+        eprintln!(
+            "DEBUG PICS FULL BUFFER:\n{}",
+            String::from_utf8_lossy(&buffer)
+        );
 
         let mut out = Vec::new();
         if let Ok(vdf) = find_vdf_in_pics(&buffer) {
