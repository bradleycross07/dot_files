+  }
+  let key = key.clone();
+  tokio::task::spawn_blocking(move || {
+    match super::liked_songs_cache::store(&path, &key, &tracks) {
+      Ok(()) => log::debug!("liked songs cache: stored {} songs", tracks.len()),
+      Err(error) => log::warn!("liked songs cache: could not store: {error}"),
+    }
+  });
+}
