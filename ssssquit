[32m+# Set CPU energy/performance policies EPP and EPB:[m
[32m+#   performance, balance_performance, default, balance_power, power.[m
[32m+# Values are given in order of increasing power saving.[m
[32m+# Requires:[m
[32m+# * Intel CPU[m
[32m+#   EPP: Intel Core i 6th gen. or newer CPU with intel_pstate driver[m
[32m+#   EPB: Intel Core i 2nd gen. or newer CPU with intel_pstate driver[m
[32m+#   EPP and EPB are mutually exclusive: when EPP is available, Intel CPUs[m
[32m+#   will not honor EPB. Only the matching feature will be applied by TLP.[m
[32m+# * AMD Zen 2 or newer CPU[m
[32m+#   EPP: amd-pstate driver in active mode ('amd-pstate-epp') as of kernel 6.3[m
[32m+# Default: balance_performance (AC), balance_power (BAT), power (SAV)[m
[32m+[m
[32m+CPU_ENERGY_PERF_POLICY_ON_AC=performance[m
[32m+CPU_ENERGY_PERF_POLICY_ON_BAT=power[m
[32m+#CPU_ENERGY_PERF_POLICY_ON_SAV=power[m
[32m+[m
[32m+# Set Intel CPU P-state performance: 0..100 (%).[m
[32m+# Limit the max/min P-state to control the power dissipation of the CPU.[m
[32m+# Values are stated as a percentage of the available performance.[m
[32m+# Requires Intel Core i 2nd gen. or newer CPU with intel_pstate driver.[m
[32m+# Default: <none>[m
[32m+[m
[32m+#CPU_MIN_PERF_ON_AC=10[m
[32m+#CPU_MAX_PERF_ON_AC=100[m
[32m+#CPU_MIN_PERF_ON_BAT=0[m
[32m+#CPU_MAX_PERF_ON_BAT=70[m
[32m+#CPU_MIN_PERF_ON_SAV=0[m
[32m+#CPU_MAX_PERF_ON_SAV=60[m
[32m+[m
[32m+# Set the CPU "turbo boost" (Intel) or "core performance boost" (AMD) feature:[m
[32m+#   0=disable, 1=allow.[m
[32m+# Allows to raise the maximum frequency/P-state of some cores if the[m
[32m+# CPU chip is not fully utilized and below it's intended thermal budget.[m
[32m+# Note: a value of 1 does *not* activate boosting, it just allows it.[m
[32m+# Default: <none>[m
[32m+[m
[32m+CPU_BOOST_ON_AC=1[m
[32m+CPU_BOOST_ON_BAT=0[m
[32m+#CPU_BOOST_ON_SAV=0[m
[32m+[m
[32m+# Set CPU dynamic boost feature:[m
[32m+#   0=disable, 1=enable.[m
[32m+# Improve performance by increasing minimum P-state limit dynamically[m
[32m+# whenever a task previously waiting on I/O is selected to run.[m
[32m+# Requires Intel Core i  6th gen. or newer CPU with intel_pstate driver[m
[32m+# in active mode.[m
[32m+# Note: AMD CPUs currently have no tunable for this.[m
[32m+# Default: <none>[m
[32m+[m
[32m+#CPU_HWP_DYN_BOOST_ON_AC=1[m
[32m+#CPU_HWP_DYN_BOOST_ON_BAT=1[m
[32m+#CPU_HWP_DYN_BOOST_ON_SAV=0[m
[32m+[m
[32m+# Kernel NMI Watchdog:[m
[32m+#   0=disable (default, saves power), 1=enable (for kernel debugging only).[m
[32m+# Default: 0[m
[32m+[m
[32m+#NMI_WATCHDOG=0[m
[32m+[m
[32m+# Select platform profile:[m
[32m+#   performance, balanced, low-power.[m
[32m+# Controls system operating characteristics around power/performance levels,[m
[32m+# thermal and fan speed. Values are given in order of increasing power saving.[m
[32m+# Note: check the output of tlp-stat -p to determine availability on your[m
[32m+# hardware and additional profiles such as: balanced-performance, quiet, cool.[m
[32m+# Default: performance (AC), balanced (BAT), low-power (SAV)[m
[32m+[m
[32m+#PLATFORM_PROFILE_ON_AC=performance[m
[32m+#PLATFORM_PROFILE_ON_BAT=balanced[m
[32m+#PLATFORM_PROFILE_ON_SAV=low-power[m
[32m+[m
[32m+# System suspend mode:[m
[32m+#   s2idle: Idle standby - a pure software, light-weight, system sleep state,[m
[32m+#   deep: Suspend to RAM - the whole system is put into a low-power state,[m
[32m+#     except for memory, usually resulting in higher savings than s2idle.[m
[32m+# CAUTION: changing suspend mode may lead to system instability and even[m
[32m+# data loss. As for the availability of different modes on your system,[m
[32m+# check the output of tlp-stat -s. If unsure, stick with the system default[m
[32m+# by not enabling this.[m
[32m+# Default: <none>[m
[32m+[m
[32m+#MEM_SLEEP_ON_AC=s2idle[m
[32m+#MEM_SLEEP_ON_BAT=deep[m
[32m+[m
[32m+# Define disk devices on which the following DISK/AHCI_RUNTIME parameters act.[m
[32m+# Separate multiple devices with spaces.[m
[32m+# Devices can be specified by disk ID also (lookup with: tlp diskid).[m
[32m+# Default: "nvme0n1 sda"[m
[32m+[m
[32m+#DISK_DEVICES="nvme0n1 sda"[m
[32m+[m
[32m+# Disk advanced power management level: 1..254, 255 (max saving, min, off).[m
[32m+# Levels 1..127 may spin down the disk; 255 allowable on most drives.[m
[32m+# Separate values for multiple disks with spaces. Use the special value 'keep'[m
[32m+# to keep the hardware default for the particular disk.[m
[32m+# Default: 254 (AC), 128 (BAT)[m
[32m+[m
[32m+#DISK_APM_LEVEL_ON_AC="254 254"[m
[32m+#DISK_APM_LEVEL_ON_BAT="128 128"[m
[32m+[m
[32m+# Exclude disk classes from advanced power management (APM):[m
[32m+#   sata, ata, usb, ieee1394.[m
[32m+# Separate multiple classes with spaces.[m
[32m+# CAUTION: USB and IEEE1394 disks may fail to mount or data may get corrupted[m
[32m+# with APM enabled. Be careful and make sure you have backups of all affected[m
[32m+# media before removing 'usb' or 'ieee1394' from the denylist![m
[32m+# Default: "usb ieee1394"[m
[32m+[m
[32m+#DISK_APM_CLASS_DENYLIST="usb ieee1394"[m
[32m+[m
[32m+# Hard disk spin down timeout:[m
[32m+#   0:        spin down disabled[m
[32m+#   1..240:   timeouts from 5s to 20min (in units of 5s)[m
[32m+#   241..251: timeouts from 30min to 5.5 hours (in units of 30min)[m
[32m+# See 'man hdparm' for details.[m
[32m+# Separate values for multiple disks with spaces. Use the special value 'keep'[m
[32m+# to keep the hardware default for the particular disk.[m
[32m+# Default: <none>[m
[32m+[m
[32m+#DISK_SPINDOWN_TIMEOUT_ON_AC="0 0"[m
[32m+#DISK_SPINDOWN_TIMEOUT_ON_BAT="0 0"[m
[32m+[m
[32m+# Select I/O scheduler for the disk devices.[m
[32m+# Multi queue (blk-mq) schedulers:[m
[32m+#   mq-deadline(*), none, kyber, bfq[m
[32m+# Single queue schedulers:[m
[32m+#   deadline(*), cfq, bfq, noop[m
[32m+# (*) recommended.[m
[32m+# Separate values for multiple disks with spaces. Use the special value 'keep'[m
[32m+# to keep the kernel default scheduler for the particular disk.[m
[32m+# Notes:[m
[32m+# - Multi queue (blk-mq) may need kernel boot option 'scsi_mod.use_blk_mq=1'[m
[32m+#   and 'modprobe mq-deadline-iosched|kyber|bfq' on kernels < 5.0[m
[32m+# - Single queue schedulers are legacy now and were removed together with[m
[32m+#   the old block layer in kernel 5.0[m
[32m+# Default: keep[m
[32m+[m
[32m+#DISK_IOSCHED="mq-deadline mq-deadline"[m
[32m+[m
[32m+# AHCI link power management (ALPM) for SATA disks:[m
[32m+#   min_power, med_power_with_dipm(*), medium_power, max_performance.[m
[32m+# (*) recommended.[m
[32m+# Multiple values separated with spaces are tried sequentially until success.[m
[32m+# Default: med_power_with_dipm (AC & BAT)[m
[32m+[m
[32m+SATA_LINKPWR_ON_AC="med_power_with_dipm"[m
[32m+#SATA_LINKPWR_ON_BAT="med_power_with_dipm"[m
[32m+[m
